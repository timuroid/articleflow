{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_id",
    "template_version_id",
    "blocks",
    "figures",
    "labels"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "input_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "template_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "role_id",
          "spans"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "role_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "semantic_rule_id",
                "character_style_id"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "semantic_rule_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "character_style_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "maxItems": 30000
          }
        }
      },
      "maxItems": 30000,
      "minItems": 1
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "marker_id",
          "caption_block_id",
          "object_rule_id"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "marker_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "caption_block_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "object_rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "maxItems": 30000
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "label_rule_id",
          "action",
          "source_span"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "label_rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "action": {
            "enum": [
              "reuse_existing",
              "insert_literal"
            ]
          },
          "source_span": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "insert_literal"
                }
              }
            },
            "then": {
              "properties": {
                "source_span": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "reuse_existing"
                }
              }
            },
            "then": {
              "properties": {
                "source_span": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "maxItems": 30000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:articleflow:document-plan:0.2",
  "title": "DocumentPlan limited paragraph and inline image profile"
}
