{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:articleflow:classification:0.1",
  "title": "ArticleFlow block classification response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "chunk_id", "assignments"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "chunk_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "role", "confidence", "evidence_block_ids", "reason"],
        "properties": {
          "block_id": {"type": "string", "pattern": "^b-[0-9]{6}$"},
          "role": {
            "enum": ["title", "authors", "affiliation", "abstract", "keywords", "heading_1", "heading_2", "heading_3", "body", "figure_caption", "table_caption", "references_heading", "reference_entry", "unknown"]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_block_ids": {
            "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^b-[0-9]{6}$"}
          },
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
